{
  "name": "happiness-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Europas Social-Community-Plattform für Glück, Vernetzung und persönliche Entwicklung.",
  "author": "Harro Goerndt <datdienstleistungen@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/nexus-guard.mjs && vite build",
    "preview": "vite preview",
    "guard": "node scripts/nexus-guard.mjs --auto-close",
    "guard:check": "node scripts/nexus-guard.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:leak": "node scripts/check-bundle-leak.mjs",
    "purge:db": "node scripts/purge-database.mjs",
    "watchdog": "node scripts/watchdog_protected_leads.js",
    "test": "npx playwright test",
    "test:e2e:api": "npx playwright test --project=api",
    "test:e2e:ui": "npx playwright test --project=chromium",
    "test:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "@netlify/functions": "^5.3.0",
    "@supabase/supabase-js": "^2.49.0",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.3.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.61.1",
    "vite": "^6.0.0"
  }
}
